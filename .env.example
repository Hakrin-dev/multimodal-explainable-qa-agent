# ===== LLM providers (OpenAI-compatible) =====
# main provider: deepseek | qwen | siliconflow | mock
LLM_PROVIDER=mock
LLM_MODEL=deepseek-chat

# DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Qwen / DashScope compatible mode (https://dashscope.console.aliyun.com)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# SiliconFlow (备胎)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ===== Database =====
POSTGRES_USER=chinook
POSTGRES_PASSWORD=chinook123
POSTGRES_DB=chinook
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ===== LLM layer options =====
# response cache (SQLite) for dev/eval speed & cost control
LLM_RESPONSE_CACHE=1
# usage accounting db file
LLM_USAGE_DB=var/llm_usage.sqlite
DOCKER_REGISTRY_MIRROR=

# ===== LLM providers (OpenAI-compatible) =====
# main provider: deepseek | qwen | siliconflow | mock
# 主力已定案（docs/llm_selection_report.md）：deepseek；mock=无 key 演示用
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat

# DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Qwen / DashScope compatible mode (https://dashscope.console.aliyun.com)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# SiliconFlow (备胎)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ===== Database =====
POSTGRES_USER=chinook
POSTGRES_PASSWORD=chinook123
POSTGRES_DB=chinook
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ===== Embedding (D9-B: local first) =====
# local = models/bge-small-zh-v1.5 (CPU, 512d); W3 换 BGE-M3 时改路径并重摄入
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_PATH=models/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

# ===== RAG reranker (disabled by default; W3 GPU profile enables it) =====
RERANK_ENABLED=0
RERANK_PROVIDER=local
RERANK_MODEL_PATH=models/bge-reranker-v2-m3
RERANK_DEVICE=cpu
RERANK_BATCH_SIZE=8
RERANK_CANDIDATE_K=20
RERANK_MAX_LENGTH=512

# ===== RAG faithfulness self-check =====
# Keep disabled during ordinary tests; enable for W5 real-provider evaluation.
RAG_FACTCHECK_ENABLED=0
RAG_FACTCHECK_MAX_ROUNDS=2

# ===== Formula extraction during ingestion =====
# Disabled by default to avoid unintended paid LLM calls.
FORMULA_EXTRACT_ENABLED=0
FORMULA_EXTRACT_MAX_BLOCKS=40
FORMULA_EXTRACT_MAX_FORMULAS=20

# ===== MinerU document parsing/repair =====
# Keep MinerU in an isolated environment; point this to its CLI.
MINERU_BIN=/path/to/mqa-mineru/bin/mineru-kit
MINERU_HOME=/path/to/mineru-cache
MINERU_MODEL_SOURCE=modelscope
MINERU_TABLE_DEVICE=cpu
MINERU_TIER=basic
MINERU_TIMEOUT_SECONDS=900
# Required by the validated RTX 5090 + vLLM profile.
VLLM_USE_FLASHINFER_SAMPLER=0

# ===== LLM layer options =====
# response cache (SQLite) for dev/eval speed & cost control
LLM_RESPONSE_CACHE=1
# usage accounting db file
LLM_USAGE_DB=var/llm_usage.sqlite
DOCKER_REGISTRY_MIRROR=

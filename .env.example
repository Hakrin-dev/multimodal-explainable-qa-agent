# ===== LLM providers (OpenAI-compatible) =====
# main provider: deepseek | qwen | siliconflow | mock
# 主力已定案（docs/llm_selection_report.md）：deepseek；mock=无 key 演示用
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat

# DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Qwen / DashScope compatible mode (https://dashscope.console.aliyun.com)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# SiliconFlow (备胎)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ===== Database =====
POSTGRES_USER=chinook
POSTGRES_PASSWORD=chinook123
POSTGRES_DB=chinook
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ===== Embedding (D9-B: local first) =====
# local = models/bge-small-zh-v1.5 (CPU, 512d); W3 换 BGE-M3 时改路径并重摄入
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_PATH=models/bge-small-zh-v1.5
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

# ===== LLM layer options =====
# response cache (SQLite) for dev/eval speed & cost control
LLM_RESPONSE_CACHE=1
# usage accounting db file
LLM_USAGE_DB=var/llm_usage.sqlite
DOCKER_REGISTRY_MIRROR=

{"id": "mts-006", "category": "multiturn_script", "description": "文档五轮话题：年假→事假→提成→制度总结→寒暄", "turns": [{"q": "按员工手册，年假有几天", "expect": {"status": "ok", "intent": "DOC_QUERY"}}, {"q": "那事假呢", "expect": {"status": "ok"}}, {"q": "销售提成怎么算", "expect": {"status": "ok"}}, {"q": "把刚才的制度要点总结一下", "expect": {"status": "ok"}}, {"q": "明白了，谢谢", "expect": {"status": "ok"}}]}

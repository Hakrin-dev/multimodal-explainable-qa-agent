{"id": "mts-003", "category": "multiturn_script", "description": "澄清挂起与恢复（槽位矩阵+选项式）", "turns": [{"q": "销售额增长率是多少", "expect": {"status": "clarify"}}, {"q": "对比 2024 年和 2023 年全年", "expect": {"status": "ok", "facts": ["469", "477"]}}]}
{"id": "mts-004", "category": "multiturn_script", "description": "混合长对话 6 轮：DB→过滤追问→澄清→恢复→Doc→Doc指代", "turns": [{"q": "一共有多少位客户", "expect": {"status": "ok", "intent": "DB_QUERY", "facts": ["59"]}}, {"q": "来自美国的有哪些", "expect": {"status": "ok", "facts": ["13"]}}, {"q": "销售额增长率是多少", "expect": {"status": "clarify"}}, {"q": "对比 2024 年和 2023 年全年", "expect": {"status": "ok", "facts": ["469", "477"]}}, {"q": "按员工手册，销售提成怎么算", "expect": {"status": "ok", "intent": "DOC_QUERY", "facts": ["3%", "2%"]}}, {"q": "那事假呢", "expect": {"status": "ok", "rewritten_contains": ["事假"], "facts": ["5"]}}]}

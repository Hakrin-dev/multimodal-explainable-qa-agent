{"id": "mts-001", "category": "multiturn_script", "description": "指代追问：数字轮换（销量 2024→2023→对比）", "turns": [{"q": "2024 年销售额是多少", "expect": {"status": "ok", "intent": "DB_QUERY", "facts": ["477"]}}, {"q": "那 2023 年呢", "expect": {"status": "ok", "rewritten_contains": ["2023"], "facts": ["469"]}}, {"q": "哪一年更高", "expect": {"status": "ok", "facts": ["2024"]}}]}
